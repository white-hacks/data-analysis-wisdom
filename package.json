{
  "name": "the-tableau-repo",
  "version": "1.0.0",
  "description": "The Tableau Repo (thetableaurepo.com): curated Tableau data visualization tips & principles: articles, visualizations and quotes from the community's experts.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "validate": "node scripts/validate-content.js",
    "check:site": "node scripts/check-site.js",
    "check:links": "node scripts/check-links.js",
    "verify:quotes": "node scripts/verify-quotes.js",
    "fetch:vizzes": "node scripts/fetch-vizzes.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "js-yaml": "5.4.3",
    "playwright": "1.56.1"
  }
}
