---
# /quotes/ – links to one quotes page per article category.
layout: layouts/base.njk
title: Short quotes
description: Memorable lines from Tableau experts, quoted word for word from the articles on The Tableau Repo and arranged by topic.
accent: aqua
---
{% from "macros/components.njk" import pageHeader, linkCard with context %}
{{ pageHeader("Short quotes", "Memorable lines from the articles on this site, quoted word for word and arranged by the same categories as the articles. Every quote links to its source.", [], catalog.stats.quotes ~ " quotes in " ~ (catalog.categories | length) ~ " categories") }}

<section class="container section">
  <div class="card-grid">
    {%- for category in catalog.categories %}
      {%- set q = category.featuredQuote -%}
      {#- The quote goes in the description, which is never cut short, so its author always shows. #}
      {{ linkCard(category.title, category.quotesUrl, ("“" ~ (q.text | smartQuotes) ~ "” (" ~ q.author ~ ")") if q else null, category.quoteCount ~ " quotes", category.color) }}
    {%- endfor %}
  </div>
</section>
