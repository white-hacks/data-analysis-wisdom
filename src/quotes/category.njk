---
# /quotes/<category>/ – one page per category (generated by pagination).
# Quotes are grouped under the category's subcategories, in the same order
# as the Articles section.
layout: layouts/base.njk
pagination:
  data: catalog.categories
  size: 1
  alias: category
  addAllPagesToCollections: true
permalink: "{{ category.quotesUrl }}"
eleventyComputed:
  title: "{{ category.title | safe }} quotes"
  description: "{{ category.quoteCount }} short quotes from the {{ category.title | safe }} articles on The Tableau Repo, quoted word for word from Tableau experts and linked to their source."
  accent: "{{ category.color }}"
---
{% from "macros/components.njk" import pageHeader, quoteGrid with context %}
{{ pageHeader(category.title ~ " quotes", "Short quotes from the articles in " ~ category.title ~ ", word for word, each linked to its source.", [{ title: "Short quotes", url: "/quotes/" }], category.quoteCount ~ " quotes") }}

{%- set topicsWithQuotes = [] -%}
{%- for topic in category.topics %}{% if topic.quotes.length %}{% set topicsWithQuotes = (topicsWithQuotes.push(topic), topicsWithQuotes) %}{% endif %}{% endfor -%}

{%- if topicsWithQuotes.length > 1 %}
<nav class="container section section--tight" aria-label="Topics on this page">
  <ul class="chips">
    {%- for topic in topicsWithQuotes %}<li><a class="chip" href="#{{ topic.slug }}">{{ topic.title }}</a></li>{% endfor %}
  </ul>
</nav>
{%- endif %}

{%- for topic in topicsWithQuotes %}
<section class="container section" id="{{ topic.slug }}">
  <div class="section__heading">
    <h2 class="section__title">{{ topic.title }}</h2>
    <a class="section__more" href="{{ topic.url }}">Read the {{ topic.placements.count }} articles<span class="visually-hidden"> on {{ topic.title }}</span><span aria-hidden="true"> →</span></a>
  </div>
  {{ quoteGrid(topic.quotes, category.color) }}
</section>
{%- endfor %}

{%- if category.quotes.length %}
<section class="container section">
  {{ quoteGrid(category.quotes, category.color) }}
</section>
{%- endif %}
