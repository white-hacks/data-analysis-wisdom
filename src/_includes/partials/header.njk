{#
  partials/header.njk
  ----------------------------------------------------------------------------
  Site header: logo (links home) and the hover menu.
  Included once, by layouts/base.njk.
#}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="{{ catalog.site.name }}, home">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="3" y="17" width="6" height="12" rx="2" class="brand__bar brand__bar--1"/>
        <rect x="13" y="10" width="6" height="19" rx="2" class="brand__bar brand__bar--2"/>
        <rect x="23" y="3" width="6" height="26" rx="2" class="brand__bar brand__bar--3"/>
      </svg>
      <span class="brand__name">The Tableau <strong>Repo</strong></span>
    </a>
    {% include "partials/menu.njk" %}
  </div>
</header>
