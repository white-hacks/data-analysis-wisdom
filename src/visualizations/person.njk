---
# /visualizations/<person>/ – one page per featured author (generated by
# pagination over catalog.people): profile link, most-favourited vizzes,
# and their articles and quotes on this site.
layout: layouts/base.njk
pagination:
  data: catalog.people
  size: 1
  alias: person
  addAllPagesToCollections: true
permalink: "{{ person.url }}"
eleventyComputed:
  title: "{{ person.name | safe }}"
  description: "Tableau Public visualizations by {{ person.name | safe }}, plus their articles and quotes on The Tableau Repo."
  accent: orange
---
{% from "macros/components.njk" import vizCard, articleList, quoteGrid with context %}
{%- set gallery = person.gallery -%}
<header class="page-header">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/visualizations/">Visualizations</a></li>
        <li aria-current="page">{{ person.name }}</li>
      </ol>
    </nav>
    <div class="profile">
      {%- if gallery.avatarUrl %}
      <img class="avatar avatar--large" src="{{ gallery.avatarUrl }}" alt="" width="96" height="96">
      {%- endif %}
      <div class="profile__text">
        <h1 class="page-header__title">{{ person.name }}</h1>
        <p class="profile__affiliation">{{ person.affiliation }}</p>
        <p class="page-header__intro">{{ person.bio }}</p>
        <p class="profile__links">
          <a class="button button--primary" href="{{ person.tableauPublic }}" target="_blank" rel="noopener">Tableau Public profile<span class="external" aria-hidden="true">&#8288;↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
          {%- if person.website %}
          <a class="button" href="{{ person.website }}" target="_blank" rel="noopener">{{ person.website | hostname }}<span class="external" aria-hidden="true">&#8288;↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
          {%- endif %}
        </p>
        {%- if gallery.workbookCount %}
        <p class="page-header__meta">{{ gallery.workbookCount | compactNumber }} public workbooks{% if gallery.followers %} · {{ gallery.followers | compactNumber }} followers{% endif %} on Tableau Public</p>
        {%- endif %}
      </div>
    </div>
  </div>
</header>

<section class="container section">
  <div class="section__heading">
    {#- Ranked by favourites, then views (scripts/fetch-vizzes.js). #}
    <h2 class="section__title">{{ "Most-favourited vizzes" if (gallery.vizzes | sum("favorites")) else "Most-viewed vizzes" }}</h2>
    <a class="section__more" href="{{ person.tableauPublic }}" target="_blank" rel="noopener">All vizzes on Tableau Public<span class="external" aria-hidden="true">&#8288;↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
  </div>
  {%- if gallery.vizzes.length %}
  <div class="card-grid card-grid--vizzes">
    {%- for viz in gallery.vizzes %}{{ vizCard(viz) }}{% endfor %}
  </div>
  <p class="fine-print">Thumbnails load from Tableau Public. Gallery updated {{ gallery.fetchedAt }}.</p>
  {%- else %}
  <p>Visit <a href="{{ person.tableauPublic }}" target="_blank" rel="noopener">{{ person.name }}'s Tableau Public profile<span class="visually-hidden"> (opens in a new tab)</span></a> to explore their work.</p>
  {%- endif %}
</section>

{%- if person.articles.length %}
<section class="container section">
  <h2 class="section__title">Articles by {{ person.name }}</h2>
  {%- set items = [] -%}
  {%- for article in person.articles %}{% set items = (items.push({ article: article, note: null }), items) %}{% endfor -%}
  {{ articleList(items) }}
</section>
{%- endif %}

{%- if person.quotes.length %}
<section class="container section">
  <h2 class="section__title">Quotes</h2>
  {{ quoteGrid(person.quotes, "orange") }}
</section>
{%- endif %}
