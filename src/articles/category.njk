---
# /articles/<category>/ – one page per category (generated by pagination).
# Lists the category's subcategories. A category without subcategories
# (Miscellaneous) lists its articles directly instead.
layout: layouts/base.njk
pagination:
  data: catalog.categories
  size: 1
  alias: category
  addAllPagesToCollections: true
permalink: "/articles/{{ category.slug }}/"
eleventyComputed:
  title: "{{ category.title }}"
  description: "{{ category.description }}"
  accent: "{{ category.color }}"
---
{% from "macros/components.njk" import pageHeader, linkCard, articleList, quoteGrid with context %}
{{ pageHeader(category.title, category.description, [{ title: "Articles", url: "/articles/" }], (((category.topics | length) ~ " topics · ") if category.topics.length else "") ~ category.articleCount ~ " articles") }}

<section class="container section">
  {%- if category.topics.length %}
  <div class="card-grid">
    {%- for topic in category.topics %}
      {{ linkCard(topic.title, topic.url, topic.description, topic.placements.count ~ " articles", category.color, topic.previewTitles) }}
    {%- endfor %}
  </div>
  {%- else %}
  {{ articleList(category.placements.main) }}
  {%- endif %}
</section>

{%- if not category.topics.length and category.quotes.length %}
<section class="container section">
  <h2 class="section__title">Short quotes</h2>
  {{ quoteGrid(category.quotes, category.color) }}
</section>
{%- endif %}
